rules_version = '2';

// Security rules for the Dormitory Fault Reporting and Maintenance Management
// System. Principle: least privilege. Every rule is covered by an automated
// test in tests/rules/firestore.rules.test.ts.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Identity and roles ----------

    function isSignedIn() {
      return request.auth != null;
    }

    function profilePath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function hasProfile() {
      return isSignedIn() && exists(profilePath());
    }

    function me() {
      return get(profilePath()).data;
    }

    function isAdmin() {
      return hasProfile() && me().role == 'admin';
    }

    function isTechnician() {
      return hasProfile() && me().role == 'technician';
    }

    function isStudent() {
      return hasProfile() && me().role == 'student';
    }

    // ---------- Shared checks ----------

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // Priority follows the maintenance classification (stored as urgency):
    // Emergency -> critical, Priority (urgent) -> high, Routine (normal) -> low.
    function priorityFor(urgency) {
      return urgency == 'emergency' ? 'critical' : (urgency == 'urgent' ? 'high' : 'low');
    }

    function validReportContent(d) {
      return d.title is string && d.title.size() >= 5 && d.title.size() <= 120
        && d.description is string && d.description.size() >= 10 && d.description.size() <= 2000
        && d.category in ['electrical', 'plumbing', 'hvac', 'structural', 'internet', 'furniture', 'other']
        && d.urgency in ['normal', 'urgent', 'emergency']
        && d.photoURL is string && d.photoURL.size() <= 2000;
    }

    // The report is assigned to the signed-in technician: by account ID, or
    // by name for reports assigned before account IDs were stored.
    function assignedToMe(report) {
      return report.get('assignedToId', null) == request.auth.uid
        || (report.get('assignedToId', null) == null
            && report.get('assignedTo', null) != null
            && report.assignedTo == me().name);
    }

    function technicianTransition(from, to) {
      return from == to
        || (from == 'open' && to == 'in-progress')
        || (from == 'in-progress' && to == 'resolved')
        || (from == 'resolved' && to == 'in-progress');
    }

    function adminTransition(from, to) {
      return from == to
        || (from == 'open' && to in ['in-progress', 'closed'])
        || (from == 'in-progress' && to in ['resolved', 'open', 'closed'])
        || (from == 'resolved' && to in ['closed', 'in-progress'])
        || (from == 'closed' && to == 'open');
    }

    // ---------- User profiles ----------

    match /users/{userId} {
      // A user reads their own profile; administrators read all profiles.
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isSignedIn()
        && (isAdmin() || resource.data.email == request.auth.token.email);

      // Only administrators manage profiles, so nobody can change their own role.
      allow create, update: if isAdmin()
        && request.resource.data.role in ['student', 'technician', 'admin']
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 80
        && request.resource.data.email is string;

      // An administrator cannot delete their own profile (avoids lock-out).
      allow delete: if isAdmin() && request.auth.uid != userId;
    }

    // ---------- Fault reports ----------

    match /fault_reports/{reportId} {
      // Staff read all reports; a resident reads only their own.
      allow read: if isAdmin()
        || isTechnician()
        || (isStudent() && resource.data.studentId == request.auth.uid);

      // A resident creates a report for themselves: open, unassigned, with
      // valid content and the priority that matches the classification.
      allow create: if isStudent()
        && request.resource.data.keys().hasOnly([
             'title', 'category', 'urgency', 'priority', 'description', 'photoURL',
             'status', 'studentId', 'studentName', 'dormitory', 'roomNumber',
             'assignedTo', 'assignedToId', 'createdAt', 'updatedAt'
           ])
        && request.resource.data.studentId == request.auth.uid
        && request.resource.data.status == 'open'
        && request.resource.data.assignedTo == null
        && request.resource.data.get('assignedToId', null) == null
        && validReportContent(request.resource.data)
        && request.resource.data.priority == priorityFor(request.resource.data.urgency)
        && request.resource.data.createdAt == request.time;

      allow update: if
        // Administrator: manages status, assignment and priority, but cannot
        // change who reported the fault or when.
        (isAdmin()
          && !changedKeys().hasAny(['studentId', 'createdAt'])
          && adminTransition(resource.data.status, request.resource.data.status)
          && request.resource.data.priority in ['critical', 'high', 'medium', 'low'])

        // Technician: only on reports assigned to them, and only the status
        // and resolution note, following the technician workflow.
        || (isTechnician()
          && assignedToMe(resource.data)
          && changedKeys().hasOnly(['status', 'resolutionNote', 'updatedAt'])
          && technicianTransition(resource.data.status, request.resource.data.status)
          && request.resource.data.get('resolutionNote', '') is string
          && request.resource.data.get('resolutionNote', '').size() <= 1000)

        // Resident: edits their own report only while it is open, unassigned
        // and not yet triaged; the priority must match the classification.
        || (isStudent()
          && resource.data.studentId == request.auth.uid
          && resource.data.status == 'open'
          && resource.data.assignedTo == null
          && resource.data.get('priorityOverridden', false) != true
          && changedKeys().hasOnly([
               'title', 'category', 'urgency', 'description', 'photoURL', 'priority', 'updatedAt'
             ])
          && validReportContent(request.resource.data)
          && request.resource.data.priority == priorityFor(request.resource.data.urgency));

      allow delete: if isAdmin();
    }

    // ---------- History (audit trail) ----------

    match /status_log/{logId} {
      // Staff read all history; a resident reads the history of their own reports.
      allow read: if isAdmin()
        || isTechnician()
        || (isStudent() && resource.data.reportOwnerId == request.auth.uid);

      function report() {
        return get(/databases/$(database)/documents/fault_reports/$(request.resource.data.reportId)).data;
      }

      // Entries are written by the person who made the change, under their
      // real identity and role, for a report they are allowed to act on.
      allow create: if hasProfile()
        && request.resource.data.keys().hasOnly([
             'reportId', 'reportOwnerId', 'type', 'from', 'to', 'note',
             'actorId', 'actorName', 'actorRole', 'timestamp'
           ])
        && request.resource.data.actorId == request.auth.uid
        && request.resource.data.actorRole == me().role
        && request.resource.data.timestamp == request.time
        && request.resource.data.type in ['created', 'edited', 'status', 'assignment', 'priority', 'note']
        && request.resource.data.note is string && request.resource.data.note.size() <= 1000
        && request.resource.data.reportOwnerId == report().studentId
        && (
          me().role == 'admin'
          || (me().role == 'technician'
              && request.resource.data.type in ['status', 'note']
              && assignedToMe(report()))
          || (me().role == 'student'
              && request.resource.data.type in ['created', 'edited']
              && report().studentId == request.auth.uid)
        );

      // The audit trail is append-only.
      allow update, delete: if false;
    }
  }
}
