# Copy this file to .env.local and fill in the values.
# .env.local is ignored by git - never commit real values.

# Public (safe in the browser): where the Appwrite project lives.
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
NEXT_PUBLIC_APPWRITE_PROJECT_ID=

# SECRET (server only): Appwrite Console > Overview > API keys.
# Scopes needed: databases, tables, columns, indexes, rows (read+write),
# buckets and files (read+write), users (read+write).
# Never give this a NEXT_PUBLIC_ name and never paste it into chat or code.
APPWRITE_API_KEY=

# Optional (server only, not secret): how long a free-item reservation lasts,
# in hours (1 to 168). Leave empty for the default of 24.
FREE_RESERVATION_HOURS=

# SECRET, only needed to run the API tests (npm run test:api): the password
# shared by the test accounts that npm run appwrite:test-users creates.
TEST_USER_PASSWORD=

# A separate Appwrite project for tests uses the same names in a second file,
# .env.test.local, read by the tp:* commands (see README).
